# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=CascadeIQ
APP_VERSION=0.1.0
DEBUG=false

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ─── Study Area ───────────────────────────────────────────────────────────────
STUDY_AREA=Bengaluru Urban
STUDY_AREA_STATE=Karnataka
STUDY_AREA_COUNTRY=India

# ─── Coordinate Reference Systems ─────────────────────────────────────────────
COORDINATE_SYSTEM=EPSG:4326
LOCAL_CRS=EPSG:32643          # UTM Zone 43N for Karnataka

# ─── Graph / OSM ──────────────────────────────────────────────────────────────
USE_BUNDLED_GRAPH=true
OSM_NETWORK_TYPE=drive

# ─── Simulation Limits ────────────────────────────────────────────────────────
MAX_SCENARIO_STEPS=50
MAX_HOSPITALS=100
MAX_AMBULANCES=500
MAX_REQUESTS=1000

# ─── Default Operational Parameters ──────────────────────────────────────────
DEFAULT_AMBULANCE_SPEED_KMH=40

# ─── Flood Risk Thresholds ────────────────────────────────────────────────────
FLOOD_RISK_RAINFALL_MM_HIGH=50
FLOOD_RISK_RAINFALL_MM_CRITICAL=100
FLOOD_RISK_WARNING_WEIGHT=0.4
FLOOD_RISK_RAINFALL_WEIGHT=0.6

# ─── Objective Function Weights ───────────────────────────────────────────────
OBJECTIVE_LAMBDA=0.3          # weight for coverage term
OBJECTIVE_MU=0.1              # weight for cascade-isolation penalty

# ─── External APIs (optional) ─────────────────────────────────────────────────
IMD_API_KEY=                  # India Meteorological Department API key (optional)

# ─── Database (optional) ──────────────────────────────────────────────────────
DATABASE_URL=                  # e.g. postgresql+asyncpg://user:pass@host/db
